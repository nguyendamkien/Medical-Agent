# Lấy API key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng (mặc định gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Embedding (OpenAI) và vector database
# Lấy API key tại https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_PATH=app/storage/chroma
VECTOR_COLLECTION=medical_documents
RAG_TOP_K=5
RAG_MIN_SCORE=0.25

# Retrieval: hybrid = BM25 + dense gộp bằng RRF; dense = chỉ tìm theo vector
RETRIEVAL_MODE=hybrid
RAG_CANDIDATES=20
RRF_K=60

# Rerank bằng cross-encoder bge-reranker-v2-m3 (chạy bằng ONNX Runtime; lần đầu tải
# ~571 MB). Trên CPU chậm: ~11.5 s/câu với 10 ứng viên, ~24 s/câu với 20 — xem docs/RAG.md.
# Bật mặc định vì mọi số đo chất lượng đều dùng rerank; đặt false nếu cần trả lời nhanh
# (đổi lại câu ngoài phạm vi không bị chặn ở retrieval).
RERANK_ENABLED=true
RERANK_ONNX_REPO=onnx-community/bge-reranker-v2-m3-ONNX
RERANK_ONNX_FILE=onnx/model_int8.onnx
RERANK_CANDIDATES=10
RERANK_MIN_SCORE=0.4

# Hội thoại
# QUERY_REWRITE_ENABLED: câu hỏi nối tiếp được Gemini viết lại thành câu độc lập trước khi tìm
#   tài liệu (thêm 1 lần gọi Gemini, ~1 s, chỉ khi đã có lịch sử chat).
# HISTORY_MAX_TURNS: số lượt hỏi–đáp gần nhất gửi kèm (1 lượt = 1 câu hỏi + 1 câu trả lời).
QUERY_REWRITE_ENABLED=true
HISTORY_MAX_TURNS=10

# Agentic RAG (docs/AGENTIC_RAG.md): Gemini tự quyết định tìm tài liệu bao nhiêu lần.
# AGENT_ENABLED: true (mặc định) = agent; false = pipeline cố định (viết lại câu hỏi → tìm 1 lần
#   → trả lời) — gọi Gemini 1–2 lần/câu thay vì 2–3, hợp hơn khi quota Gemini hạn chế.
# AGENT_MAX_TOOL_CALLS: số lần tìm tài liệu tối đa mỗi câu hỏi (mỗi lần ~12 s vì rerank).
# AGENT_MAX_TOTAL_CALLS: số lời gọi tool tối đa, kể cả đọc bài (get_article, gần như tức thì).
# AGENT_NO_CONTEXT_GUARD: không lấy được tài liệu nào thì trả lời bằng prompt "không có tài
#   liệu" như pipeline cũ, thay vì để model tự trả lời.
AGENT_ENABLED=false
AGENT_MAX_TOOL_CALLS=3
AGENT_MAX_TOTAL_CALLS=8
# Từ lần tìm thứ hai trong một câu hỏi chỉ rerank N ứng viên (lần đầu dùng RERANK_CANDIDATES).
AGENT_FOLLOWUP_RERANK_CANDIDATES=5
AGENT_NO_CONTEXT_GUARD=true
# Guardrail liều thuốc: quét câu trả lời của agent, thay hàm lượng / số lần dùng thuốc bằng
# "[liều do bác sĩ chỉ định]" trước khi gửi tới người dùng.
DOSE_GUARDRAIL=true

DATA_PATH=../data-collection/data/benh_pho_bien_10.jsonl

# Danh sách origin frontend được phép gọi API (cách nhau bởi dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
